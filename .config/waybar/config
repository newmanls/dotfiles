{
    "layer": "top",
    "position": "top",
    "reload_style_on_change": true,
    "modules-left": [
        "niri/workspaces",
        "river/tags",
        "custom/player",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        "custom/currencies",
        "tray",
        "pulseaudio",
        "battery",
    ],
    "river/tags": {
        "num-tags": 5,
    },
    "custom/player": {
        "exec": "sb-player",
        "max-length": 40,
        "interval": 1,
        "on-click": "playerctl play-pause",
    },
    "custom/currencies": {
        "exec": "sb-currencies --notify",
        "exec-on-event": false,
        "interval": 21600,
        "signal": 4,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/menu/currencies.xml",
        "menu-actions": {
            "update": "pkill -RTMIN+4 waybar",
            "open-bcv": "xdg-open https://bcv.org.ve/",
        }
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "format-muted": "󰝟",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip-format": "{volume}% ({desc})",
        "scroll-step": 5,
        "menu": "on-click-right",
        "menu-file": "~/.config/waybar/menu/pulseaudio.xml",
        "menu-actions": {
            "mute-toggle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
            "open-pavucontrol": "pavucontrol",
        }
    },
    "clock": {
      "interval": 60,
      "format": "{:%a %d  %R}",
      "tooltip": false,
      "on-click": "gsimplecal",
    },
    "tray": {
        "icon-size": 16,
        "spacing": 4,
    }
}

