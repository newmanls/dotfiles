#!/usr/bin/env python3
# api from https://dolarapi.com

import warnings

import requests
from bs4 import BeautifulSoup
from requests.packages.urllib3.exceptions import InsecureRequestWarning

BCV_URL = "https://www.bcv.org.ve/"
PARALELO_URL = "https://ve.dolarapi.com/v1/dolares/paralelo"


def safe_get(url: str, **kwargs) -> requests.Response | None:
    try:
        req = requests.get(url, timeout=10, **kwargs)
        req.raise_for_status()
        return req
    except requests.RequestException:
        return None


def get_cambios_bcv() -> list | None:
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", InsecureRequestWarning)
        req = safe_get(BCV_URL, verify=False)

    if not req:
        return None

    soup = BeautifulSoup(req.text, "lxml")
    fecha_el = soup.select_one("span.date-display-single")
    fecha = fecha_el.attrs.get("content") if fecha_el else None
    monedas = [
        ("USD", "dolar"),
        ("EUR", "euro"),
    ]

    cambios = []
    for codigo, nombre in monedas:
        el = soup.select_one(f"#{nombre} strong.strong-tb")

        if not el:
            continue
        try:
            promedio = float(el.get_text(strip=True).replace(",", "."))
        except ValueError:
            continue

        cambios.append(
            {
                "moneda": codigo,
                "fuente": "BCV",
                "nombre": nombre,
                "promedio": promedio,
                "fechaActualizacion": fecha,
            }
        )

    return cambios


def get_paralelo() -> dict | None:
    req = safe_get(PARALELO_URL)
    return req.json() if req is not None else None


if __name__ == "__main__":
    cambios = get_cambios_bcv() or []
    paralelo = get_paralelo()
    if paralelo:
        cambios.append(paralelo)

    if not cambios:
        exit(1)

    cambio_principal = next(
        (
            c.get("promedio", 0.0)
            for c in cambios
            if c.get("moneda") == "USD" and c.get("fuente") == "BCV"
        ),
        cambios[0]["promedio"] if cambios else 0.0,
    )

    text = f" {round(cambio_principal, 2)}"
    tooltip = "&#013;".join(
        "<b>{moneda} {fuente}:</b> Bs. {promedio}".format(
            moneda=c.get("moneda", "?"),
            fuente=c.get("fuente", "?"),
            promedio=round(c.get("promedio", 0.0), 2),
        )
        for c in cambios
    )

    print(text, tooltip, sep="\n")
