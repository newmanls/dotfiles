#!/usr/bin/env python3
# api from https://dolarapi.com

import warnings

import requests
from bs4 import BeautifulSoup
from requests.packages.urllib3.exceptions import InsecureRequestWarning

BCV_URL = "https://www.bcv.org.ve/"
PARALELO_URL = "https://ve.dolarapi.com/v1/dolares/paralelo"


def get_bcv() -> dict | None:
    try:
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", InsecureRequestWarning)
            req = requests.get(BCV_URL, verify=False)
            req.raise_for_status()
    except requests.exceptions.RequestException:
        return None

    soup = BeautifulSoup(req.text, "lxml")
    promedio_el = soup.select_one("#dolar strong.strong-tb")
    fecha_el = soup.select_one("span.date-display-single")

    if not promedio_el:
        return None

    promedio = float(promedio_el.get_text(strip=True).replace(",", "."))

    return {
        "moneda": "USD",
        "fuente": "bcv",
        "nombre": "BCV",
        "promedio": promedio,
        "fechaActualizacion": (
            fecha_el.attrs.get("content") if fecha_el else None
        ),
    }


def get_paralelo():
    try:
        dolarapi_req = requests.get(PARALELO_URL)
        dolarapi_req.raise_for_status()
    except requests.exceptions.RequestException:
        return None

    return dolarapi_req.json()


if __name__ == "__main__":
    bcv = get_bcv()
    paralelo = get_paralelo()
    monitors = [m for m in (bcv, paralelo) if m is not None]

    text = " " + " / ".join(
        str(round(m.get("promedio"), 2)) for m in monitors
    )
    tooltip = "&#013;".join(
        f"<b>{m.get('nombre')}:</b> Bs. {round(m.get('promedio'), 2)}"
        for m in monitors
    )

    print(text, tooltip, sep="\n")
